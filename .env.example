# Docker Compose (docker-compose.yml) reads these; it refuses to start if any are missing.
# The existing pg_data volume keeps the password it was created with (originally bonlift_ai): either keep
# that value here, or run ALTER USER bonlift_ai PASSWORD '...' inside the container before changing it.
# Avoid "$" in REDIS_PASSWORD (Compose interpolates it), or escape it as "$$".
# After changing these, run `docker compose up -d` to recreate the containers so the loopback-only
# port binding and the Redis password take effect.
POSTGRES_DB=bonlift_ai_dev
POSTGRES_USER=bonlift_ai
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password

# Must match the credentials above. URL-encode any special characters in the passwords.
# REDIS_URL must include the Redis password: redis://:<password>@localhost:6379
DATABASE_URL=postgres://bonlift_ai:change-me-postgres-password@localhost:5432/bonlift_ai_dev
REDIS_URL=redis://:change-me-redis-password@localhost:6379

# Staging only (docker-compose.staging.yml): api and worker connect as least-privilege roles with their own
# statement timeouts; DATABASE_URL above stays the owner and is used by migrate only. Create the roles first with
# deploy/db-roles.sql. Inside Compose the host is the service name "postgres", not localhost.
API_DATABASE_URL=postgres://bonlift_api:change-me-api-password@postgres:5432/bonlift_ai_staging
WORKER_DATABASE_URL=postgres://bonlift_worker:change-me-worker-password@postgres:5432/bonlift_ai_staging

# Staging only (docker-compose.staging.yml): the public hostnames routed by the Cloudflare Tunnel to Caddy.
# Hostname only: no "https://", no path, no trailing slash. They must match the tunnel's public hostname routes exactly.
# ADMIN_HOST serves the admin SPA and /api/* and must be covered entirely by a Cloudflare Access policy.
# API_HOST serves /v1/* only and is public (brand API keys authenticate each request).
ADMIN_HOST=
API_HOST=

# Registers the mock dataset dev route. Set to true for local dev only.
ENABLE_DEV_ROUTES=false

# Hashes every customer id (HMAC-SHA256) before it is stored or looked up, so no mobile number or email is kept in
# plain text. Min 32 chars of A-Z, a-z, 0-9, "-", "_"; the API refuses to start without it. Set it once per
# environment: changing it later makes every stored customer id unmatchable. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_ID_SECRET=

# Admin sign-in (Google OpenID Connect). SESSION_COOKIE_SECRET must not be a placeholder value; the API refuses to start otherwise.
# APP_BASE_URL is the origin the browser uses for the admin SPA: no path, no trailing slash. It builds the redirect
# URI ({APP_BASE_URL}/api/auth/callback/google, registered exactly on the Google OAuth client) and turns on Secure
# cookies when it starts with https://. http://localhost:5173 in development; https:// plus ADMIN_HOST on staging.
# On staging the Google OAuth client must list "<APP_BASE_URL>/api/auth/callback/google" as an authorized redirect URI.
APP_BASE_URL=

# Signs the short-lived oauth_tx sign-in cookie. Min 32 chars of A-Z, a-z, 0-9, "-", "_". Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=

# From the Google Cloud OAuth client (type "Web application") for this environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

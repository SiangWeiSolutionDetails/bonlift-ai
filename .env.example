# Docker Compose (docker-compose.yml) reads these; it refuses to start if any are missing.
# The existing pg_data volume keeps the password it was created with (originally bonlift_ai): either keep
# that value here, or run ALTER USER bonlift_ai PASSWORD '...' inside the container before changing it.
# Avoid "$" in REDIS_PASSWORD (Compose interpolates it), or escape it as "$$".
# After changing these, run `docker compose up -d` to recreate the containers so the loopback-only
# port binding and the Redis password take effect.
POSTGRES_DB=bonlift_ai_dev
POSTGRES_USER=bonlift_ai
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password

# Must match the credentials above. URL-encode any special characters in the passwords.
# REDIS_URL must include the Redis password: redis://:<password>@localhost:6379
DATABASE_URL=postgres://bonlift_ai:change-me-postgres-password@localhost:5432/bonlift_ai_dev
REDIS_URL=redis://:change-me-redis-password@localhost:6379

# Admin API bearer token (min 32 chars of A-Z, a-z, 0-9, "-", "_"); the API refuses to start without it. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Registers the mock dataset dev route. Set to true for local dev only.
ENABLE_DEV_ROUTES=false

# Admin SPA token, same value as ADMIN_TOKEN. Vite only reads env files from apps/admin,
# so put this line in apps/admin/.env.local (git-ignored), not in the root .env.
VITE_ADMIN_TOKEN=

# Hashes every customer id (HMAC-SHA256) before it is stored or looked up, so no mobile number or email is kept in
# plain text. Min 32 chars of A-Z, a-z, 0-9, "-", "_"; the API refuses to start without it. Set it once per
# environment: changing it later makes every stored customer id unmatchable. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_ID_SECRET=

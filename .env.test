# Test-only, non-secret values for the disposable database in docker-compose.test.yml. Safe to commit.
# The database name must end with _test; the integration test helpers refuse to run otherwise.
TEST_DATABASE_URL=postgres://bonlift_ai_test:bonlift_ai_test@127.0.0.1:55432/bonlift_ai_test

# Test-only admin token so buildApp() can start in integration tests. Never use this value anywhere else.
ADMIN_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Deliberately unreachable: integration tests must not depend on (or write to) a real Redis.
REDIS_URL=redis://127.0.0.1:1

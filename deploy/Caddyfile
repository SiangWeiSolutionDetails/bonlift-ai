{
	# TLS terminates at Cloudflare; cloudflared reaches Caddy over plain HTTP on localhost.
	auto_https off
}

# Cloudflare Access is the outer layer; the API itself requires a signed-in admin session (sid cookie).
http://{$ADMIN_HOST} {
	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

# Public, authenticated per request by brand API keys.
http://{$API_HOST} {
	handle /v1/* {
		reverse_proxy api:4000
	}

	handle {
		respond 404
	}
}

:80 {
	respond 404
}

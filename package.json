{
  "name": "bonlift-ai",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/db",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:contracts": "npm run build -w packages/contracts",
    "dev:contracts": "npm run dev -w packages/contracts",
    "dev:client": "npm run dev -w apps/admin",
    "dev:api": "npm run dev -w packages/api",
    "dev:worker": "npm run dev -w packages/worker",
    "dev:db": "docker compose up -d",
    "dev": "concurrently -k -n contracts,client,api,worker -c blue,magenta,green,yellow \"npm:dev:contracts\" \"npm:dev:client\" \"npm:dev:api\" \"npm:dev:worker\"",
    "test": "vitest run",
    "test:integration:up": "docker compose -f docker-compose.test.yml up -d",
    "test:integration:migrate": "DATABASE_URL=postgres://bonlift_ai:bonlift_ai@localhost:5433/bonlift_ai_test npm run migrate:up -w packages/db",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "tsx": "^4.23.6",
    "typescript": "^5.9.3",
    "vitest": "^2.0.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-wasm32-wasi": "^1.2.3",
    "@rolldown/binding-win32-x64": "*"
  }
}

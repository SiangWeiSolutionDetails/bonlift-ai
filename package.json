{
  "name": "bonlift-ai",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/db",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:contracts": "npm run build -w packages/contracts",
    "dev:contracts": "npm run dev -w packages/contracts",
    "dev:client": "npm run dev -w apps/admin",
    "dev:api": "npm run dev -w packages/api",
    "dev:worker": "npm run dev -w packages/worker",
    "dev:db": "docker compose up -d",
    "dev": "concurrently -k -n contracts,client,api,worker -c blue,magenta,green,yellow \"npm:dev:contracts\" \"npm:dev:client\" \"npm:dev:api\" \"npm:dev:worker\"",
    "test": "vitest run",
    "build:packages": "npm run build -w packages/contracts -w packages/db -w packages/worker",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:migrate": "npm run migrate:test -w packages/db",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "test:integration": "npm run test:db:up && npm run test:db:migrate && npm run test:integration:run"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "tsx": "^4.23.6",
    "typescript": "^5.9.3",
    "vitest": "^2.0.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-wasm32-wasi": "^1.2.3"
  }
}

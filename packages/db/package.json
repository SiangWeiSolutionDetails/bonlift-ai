{
  "name": "@ai-services/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node-pg-migrate --migration-file-language sql -m migrations -j sql",
    "migrate:up": "npm run migrate up",
    "migrate:down": "npm run migrate down"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "node-pg-migrate": "^9.0.0"
  }
}

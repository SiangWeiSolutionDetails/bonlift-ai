{
  "name": "@bonlift-ai/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file=../../.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js --migration-file-language sql -m migrations",
    "migrate:create": "npm run migrate create",
    "migrate:up": "npm run migrate up",
    "migrate:down": "npm run migrate down",
    "seed": "docker exec -i bonlift-ai-postgres-1 psql -U bonlift_ai -d bonlift_ai_dev < seed/seed.sql"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "node-pg-migrate": "^9.0.0",
    "vitest": "^2.0.5"
  }
}
